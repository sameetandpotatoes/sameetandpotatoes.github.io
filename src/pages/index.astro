---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import portraitHero from '../assets/portrait-hero.jpg';

const description =
  'Sameet Sapra is a software engineer based in Chicago. B.S. and M.C.S. in Computer Science, University of Illinois Urbana-Champaign, Class of 2019. Writing, projects, and published work.';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const selectedSlugs = ['i-got-hacked', 'last-year-at-uiuc', 'soa-made-simple'];
const selected = selectedSlugs
  .map((slug) => posts.find((p) => p.id === slug))
  .filter((p) => p !== undefined);

const publications = [
  {
    title: 'Scalable data classification for security and privacy',
    venue: 'Engineering at Meta',
    date: 'July 21, 2020',
    href: 'https://engineering.fb.com/2020/07/21/security/data-classification-system/',
  },
  {
    title: 'Scalable Data Classification for Security and Privacy',
    venue: 'arXiv:2006.14109',
    date: '2020',
    href: 'https://doi.org/10.48550/arXiv.2006.14109',
  },
  {
    title: 'Data-Driven Approach to Picking the Most Optimal Classification Algorithm',
    venue: 'Illinois Data Science Initiative technical report',
    date: 'June 26, 2017',
    href: '/about/',
  },
  {
    title: 'Groot poster, Engineering Open House 2017',
    venue: 'ACM at UIUC',
    date: 'March 10–11, 2017',
    href: 'https://github.com/acm-uiuc/publications/blob/HEAD/Groot_EOH2017_Poster/README.md',
  },
];

// Favorite places in Chicago — his top Beli-ranked restaurants that he
// also rated five stars on Google Maps. All data (Beli score, Google
// stars, review text + date, address) is his own, from
// src/data/favorites.json (generated from his Beli rankings export and
// his Google Maps review records; nothing invented).
import favoritesData from '../data/favorites.json';

const mapsSearch = (q: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
const embedUrl = (q: string) =>
  `https://www.google.com/maps?q=${encodeURIComponent(q)}&output=embed`;

const flatText = (t: string) => t.replace(/\s+/g, ' ').trim();
const makeExcerpt = (t: string, max = 200) => {
  const flat = flatText(t);
  if (flat.length <= max) return flat;
  const cut = flat.slice(0, max);
  return cut.slice(0, cut.lastIndexOf(' ')) + '…';
};

const favorites = favoritesData.map((f) => ({
  ...f,
  street: f.address.split(',')[0],
  mapsUrl: mapsSearch(f.mapsQuery),
  embedSrc: embedUrl(f.embedQuery),
  starsLabel: '★'.repeat(f.stars),
  excerpt: makeExcerpt(f.review),
  hasMore: flatText(f.review).length > makeExcerpt(f.review).length,
}));
const defaultFav = favorites[0];

// Payload for the small inline enhancement script below (selecting a
// card swaps the map + review). Escaped so no review text can break
// out of the JSON script block.
const favPayload = JSON.stringify(
  favorites.map((f) => ({
    name: f.name,
    street: f.street,
    embedSrc: f.embedSrc,
    dateLabel: f.dateLabel,
    excerpt: f.excerpt,
    review: f.review,
    hasMore: f.hasMore,
  })),
).replace(/</g, '\\u003c');

const mapsProfile = 'https://www.google.com/maps/contrib/105385626946375251916';
---

<BaseLayout title="Sameet Sapra" description={description}>
  <section class="hero">
    <div class="hero-photo">
      <Image
        src={portraitHero}
        alt="Sameet Sapra outdoors in autumn, red maple foliage behind him"
        width={440}
        widths={[220, 440, 660]}
        sizes="220px"
        format="webp"
        quality={82}
        loading="eager"
      />
    </div>
    <div class="hero-text">
      <h1>Hi, I'm Sameet.</h1>
      <p>
        I'm a <strong>software engineer</strong> based in Chicago. I studied
        Computer Science at the University of Illinois Urbana-Champaign —
        B.S. and M.C.S., Class of 2019, with a minor in Mathematical
        Statistics.
      </p>
      <p>
        This site is my corner of the internet: occasional writing, older
        projects, and links to my published work. These days I'm building
        software, following what's new in AI, and getting to know Chicago
        better.
      </p>
      <p class="hero-links">
        <a href="/about/">More about me →</a> · <a
          href="mailto:sameetandpotatoes@gmail.com">Get in touch →</a
        >
      </p>
    </div>
  </section>

  <section>
    <h2>Selected writing</h2>
    <PostList posts={selected} />
  </section>

  <section>
    <h2>Published work</h2>
    <ul class="pub-list">
      {
        publications.map((pub) => (
          <li>
            <a class="pub-title" href={pub.href}>
              {pub.title}
            </a>
            <div class="pub-venue">
              {pub.venue} · {pub.date}
            </div>
          </li>
        ))
      }
    </ul>
    <p><a href="/about/">All published work and profiles →</a></p>
  </section>

  <section class="measure">
    <h2>Eating</h2>
    <p>
      I eat out often in Chicago and review most places I visit on Google
      Maps, where I'm a Level 8 Local Guide.
    </p>
    <p>
      A few favorites — ranked on Beli, reviewed on Google Maps. Select one
      to see it on the map with my review.
    </p>
    <ul class="place-list">
      {
        favorites.map((fav, i) => (
          <li>
            <a
              class={`place-card${i === 0 ? ' is-selected' : ''}`}
              href={fav.mapsUrl}
              data-fav={i}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span class="place-name">{fav.name}</span>
              <span class="place-meta">
                <span class="place-addr">{fav.address}</span>
                <span class="place-scores">
                  Beli {fav.scoreLabel} · Google{' '}
                  <span
                    class="stars"
                    role="img"
                    aria-label={`${fav.stars} out of 5 stars`}
                  >
                    {fav.starsLabel}
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <figure class="map-embed">
      <iframe
        id="fav-map"
        src={defaultFav.embedSrc}
        title={`Google Map: ${defaultFav.name}, ${defaultFav.street}, Chicago`}
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <figcaption id="fav-caption">
        Map: {defaultFav.name}, {defaultFav.street}.
      </figcaption>
    </figure>
    <div class="review-panel">
      <p class="review-meta" id="fav-review-meta">
        My Google review · {defaultFav.dateLabel}
      </p>
      <p class="review-body" id="fav-review-body">
        {defaultFav.excerpt}
      </p>
      <button
        type="button"
        class="review-more"
        id="fav-review-more"
        aria-expanded="false"
        hidden={!defaultFav.hasMore}
      >
        Read full review
      </button>
    </div>
    <p>
      All of my reviews are on my <a href={mapsProfile}>Google Maps profile</a>.
    </p>
    <p>
      Other cities are on the <a href="/places/">Places page</a>.
    </p>
    <script type="application/json" id="fav-data" set:html={favPayload} />
    <script is:inline>
      (function () {
        var dataEl = document.getElementById('fav-data');
        var map = document.getElementById('fav-map');
        var caption = document.getElementById('fav-caption');
        var meta = document.getElementById('fav-review-meta');
        var body = document.getElementById('fav-review-body');
        var more = document.getElementById('fav-review-more');
        if (!dataEl || !map || !body) return;
        var places;
        try {
          places = JSON.parse(dataEl.textContent);
        } catch (e) {
          return;
        }
        var cards = Array.prototype.slice.call(
          document.querySelectorAll('[data-fav]'),
        );
        var current = 0;
        var expanded = false;
        function render() {
          var p = places[current];
          map.src = p.embedSrc;
          map.title = 'Google Map: ' + p.name + ', ' + p.street + ', Chicago';
          if (caption)
            caption.textContent = 'Map: ' + p.name + ', ' + p.street + '.';
          if (meta) meta.textContent = 'My Google review · ' + p.dateLabel;
          body.textContent = expanded ? p.review : p.excerpt;
          if (more) {
            more.hidden = !p.hasMore;
            more.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            more.textContent = expanded ? 'Show less' : 'Read full review';
          }
          cards.forEach(function (c, i) {
            c.classList.toggle('is-selected', i === current);
            if (i === current) c.setAttribute('aria-current', 'true');
            else c.removeAttribute('aria-current');
          });
        }
        cards.forEach(function (card, i) {
          card.addEventListener('click', function (e) {
            e.preventDefault();
            if (i !== current) {
              current = i;
              expanded = false;
              render();
            }
          });
        });
        if (more)
          more.addEventListener('click', function () {
            expanded = !expanded;
            render();
          });
      })();
    </script>
  </section>

  <section>
    <h2>All writing</h2>
    <PostList posts={posts} />
    <p><a href="/posts/">Browse the full archive →</a></p>
    <p>
      Food, coffee, watches, and the rest of life outside work are covered
      briefly on the <a href="/about/">About page</a>.
    </p>
  </section>
</BaseLayout>
