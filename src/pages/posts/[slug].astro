---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import portraitHero from '../../assets/portrait-hero.jpg';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });

// Reading time from the raw markdown body (~200 wpm, minimum 1).
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate}
>
  <article class="measure post-article">
    <header class="post-header">
      {
        post.data.tags.length > 0 && (
          <p class="post-kicker">{post.data.tags.join(' · ')}</p>
        )
      }
      <h1>{post.data.title}</h1>
      <p class="post-deck">{post.data.description}</p>
      <div class="byline">
        <Image
          src={portraitHero}
          alt=""
          width={84}
          height={84}
          format="webp"
          quality={75}
        />
        <div>
          <div class="byline-name">Sameet Sapra</div>
          <div class="byline-meta">
            {fmt(post.data.pubDate)} · {readMinutes} min read
          </div>
        </div>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <aside class="author-card">
      <Image
        src={portraitHero}
        alt=""
        width={128}
        height={128}
        format="webp"
        quality={75}
      />
      <div>
        <p class="author-card-name">Written by Sameet Sapra</p>
        <p class="author-card-bio">
          Software engineer in Chicago. B.S. and M.C.S. in Computer
          Science, University of Illinois Urbana-Champaign, Class of
          2019. <a href="/about/">More about me →</a>
        </p>
      </div>
    </aside>
    <nav class="post-footer-nav">
      <a href="/posts/">← Read other posts</a>
    </nav>
  </article>
</BaseLayout>
