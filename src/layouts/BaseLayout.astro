---
import { getImage } from 'astro:assets';
import portraitSocial from '../assets/portrait-social.jpg';
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource-variable/fraunces/standard-italic.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/inter/wght-italic.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
}

const { title, description, ogType = 'website', publishedTime } = Astro.props;

const siteTitle = 'Sameet Sapra';
const pageTitle = title === siteTitle ? siteTitle : `${title} · ${siteTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Social card: autumn portrait pre-cropped to the 1200x630 landscape ratio
// (face left of center, red maple foliage on the right), served as JPEG.
const og = await getImage({
  src: portraitSocial,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 80,
});
const ogImage = new URL(og.src, Astro.site).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://www.sameetsapra.com/#person',
  name: 'Sameet Sapra',
  url: 'https://www.sameetsapra.com/',
  image: 'https://www.sameetsapra.com/images/headshot.jpg',
  description:
    'Software Engineer at Meta, based in Chicago. B.S. and M.C.S. in Computer Science, University of Illinois Urbana-Champaign, Class of 2019.',
  jobTitle: 'Software Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'Meta',
    url: 'https://www.meta.com/',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Illinois Urbana-Champaign',
    url: 'https://illinois.edu/',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Chicago',
    addressRegion: 'IL',
    addressCountry: 'US',
  },
  sameAs: [
    'https://www.wikidata.org/wiki/Q141455950',
    'https://www.linkedin.com/in/sameetsapra',
    'https://github.com/sameetandpotatoes',
    'https://engineering.fb.com/author/sameet-sapra/',
    'https://devpost.com/sameetandpotatoes',
    'https://www.instagram.com/sameetandpotatoes/',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="preload"
      href={frauncesLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Sameet Sapra"
      href="/rss.xml"
    />

    <!-- Open Graph -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Person structured data (carried over from the previous site) -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href="/">Sameet Sapra</a>
        <nav class="site-nav" aria-label="Main">
          <a href="/about/">About</a>
          <a href="/posts/">Posts</a>
          <a href="mailto:sameetandpotatoes@gmail.com">Contact Me</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Sameet Sapra</span>
        <span>
          <a href="/rss.xml">RSS</a> ·
          <a href="https://github.com/sameetandpotatoes">GitHub</a> ·
          <a href="https://www.linkedin.com/in/sameetsapra">LinkedIn</a>
        </span>
        <span class="footer-note">
          This entire site is managed by <a href="https://muse.ai">Muse</a>.
        </span>
      </div>
    </footer>
  </body>
</html>
